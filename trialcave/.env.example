# Languages (first is default)
SUPPORTED_LANGUAGES=en,es,pt,ht

# Consent
CONSENT_VERSION=2026-10-24

# Platform rules
DONOR_SHARE=0.5
K_ANONYMITY_MIN=10
OUTREACH_MIN_SCORE=0.6
OUTREACH_COUNT_FLOOR=5
MAX_QUESTIONS_PER_TRIAL=5
INVITATION_EXPIRY_DAYS=30
